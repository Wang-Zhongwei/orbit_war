{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Train PPO (src.train)",
            "type": "debugpy",
            "request": "launch",
            "module": "src.train",
            "cwd": "${workspaceFolder}",
            "args": [
                "--config",
                "configs/debug.yaml",
            ]
        },
        {
            "name": "BC Encode top-10 episodes (real data)",
            "type": "debugpy",
            "request": "launch",
            "module": "src_jax.bc_encode",
            "cwd": "${workspaceFolder}",
            "args": [
                "--episodes_dir", "episodes/2026-06-04",
                "--config", "configs/bc_entity_policy_12.yaml",
                "--episodes_per_shard", "10",
                "--num_shards", "1",
                "--workers", "1",
                "--force"
            ]
        }
    ]
}